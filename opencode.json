{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENT.md"
  ],
  "mcp": {
    "servers": {
      "jira": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v2/mcp",
        "oauth": {
          "callback_port": 58617,
          "redirect_uri": "http://localhost:58617/callback"
        }
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_TOKEN}"
        }
      }
    }
  }
}
